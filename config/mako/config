# mako — niri dotfiles theme (default; overwritten by wallpaper palette)
font=JetBrains Mono Nerd Font 12
background-color=#1a1b26dd
text-color=#c0caf5
border-color=#7aa2f7
border-size=2
border-radius=10
padding=10
margin=8
width=360
height=120
anchor=top-right
default-timeout=5000
max-visible=6
icons=1
max-icon-size=32

[urgency=low]
background-color=#1a1b26dd
border-color=#7aa2f7
default-timeout=2000

[urgency=normal]
background-color=#1a1b26dd
border-color=#7aa2f7

[urgency=critical]
background-color=#2a2a33
border-color=#f7768e
default-timeout=0
