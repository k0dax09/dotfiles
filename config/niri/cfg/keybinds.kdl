binds {

    // ════════════ Apps & UI Launchers ════════════
    Mod+Return                          hotkey-overlay-title="Terminal" { spawn "alacritty"; }
    Mod+B                               hotkey-overlay-title="Browser" { spawn "helium"; }
    Mod+E                               hotkey-overlay-title="Files" { spawn "nemo"; }
    Mod+Shift+K                         hotkey-overlay-title="Passwords" { spawn "keepassxc"; }

    Mod+D                               hotkey-overlay-title="App Launcher" { spawn "fuzzel"; }
    Mod+Space                           hotkey-overlay-title="Quick Run" { spawn "fuzzel --launch-prefix"; }

    Mod+Shift+W                         hotkey-overlay-title="Wallpaper" { spawn "wallpaper.sh"; }
    Mod+V                               hotkey-overlay-title="Clipboard" { spawn "clip.sh"; }
    Mod+Shift+C                         hotkey-overlay-title="Control Center" { spawn "sh" "-c" "eww open --toggle control-center"; }
    Mod+Shift+O                         hotkey-overlay-title="Workspaces" { spawn "ws.sh"; }
    Mod+Shift+P                         hotkey-overlay-title="Toggle waybar" { spawn "waybar-toggle"; }
    Mod+Ctrl+M                          hotkey-overlay-title="Media" { spawn "media.sh"; }
    Mod+Alt+V                           hotkey-overlay-title="VPN" { spawn "proxy.sh"; }
    Mod+Alt+L                           hotkey-overlay-title="Lock screen" { spawn "lock.sh"; }
    Mod+Shift+E                         hotkey-overlay-title="Power menu" { spawn "wlogout"; }
    Mod+Alt+Delete                      hotkey-overlay-title="Power menu" { spawn "wlogout"; }

    // ══════════════ Screenshots ══════════════
    // Print — нативный niri скриншот; shot.sh — на Mod+Shift+S / F2 / F3.
    Print                               { screenshot; }
    Mod+Shift+S                         { spawn "shot.sh" "region"; }
    Mod+Shift+F2                        { spawn "shot.sh" "full"; }
    Mod+Shift+F3                        { spawn "shot.sh" "window"; }
    Mod+Ctrl+R                          repeat=false { spawn "rec.sh" "toggle"; }

    // ══════════════ Window ops ══════════════
    Mod+Q                               { close-window; }

    Mod+T                               toggle-window-floating
    Mod+F                               maximize-column
    Mod+Shift+F                         fullscreen-window
    Mod+Shift+V                         switch-focus-between-floating-and-tiling

    Mod+W                               consume-window-into-column

    // ══════════════ Focus / Movement ══════════════
    Mod+H                               focus-column-left
    Mod+L                               focus-column-right
    Mod+K                               focus-window-up
    Mod+J                               focus-window-down

    Mod+Ctrl+H                          move-column-left
    Mod+Ctrl+L                          move-column-right
    Mod+Ctrl+K                          move-window-up
    Mod+Ctrl+J                          move-window-down

    Mod+Home                            focus-column-first
    Mod+End                             focus-column-last
    Mod+Ctrl+Home                       move-column-to-first
    Mod+Ctrl+End                        move-column-to-last

    Mod+Shift+Alt+Left                  focus-monitor-left
    Mod+Shift+Alt+Right                 focus-monitor-right

    Mod+Shift+Alt+Ctrl+Left             move-column-to-monitor-left
    Mod+Shift+Alt+Ctrl+Right            move-column-to-monitor-right

    // ══════════════ Layout ══════════════
    Mod+Ctrl+F                          expand-column-to-available-width
    Mod+Ctrl+C                          center-visible-columns
    Mod+C                               center-column
    Mod+Minus                           set-column-width "-10%"
    Mod+Equal                           set-column-width "+10%"
    Mod+R                               switch-preset-column-width
    Mod+Shift+R                         switch-preset-column-width-back

    // ══════════════ Workspaces ══════════════
    Mod+1                               focus-workspace 1
    Mod+2                               focus-workspace 2
    Mod+3                               focus-workspace 3
    Mod+4                               focus-workspace 4
    Mod+5                               focus-workspace 5
    Mod+6                               focus-workspace 6
    Mod+7                               focus-workspace 7
    Mod+8                               focus-workspace 8
    Mod+9                               focus-workspace 9

    Mod+Ctrl+1                          move-column-to-workspace 1
    Mod+Ctrl+2                          move-column-to-workspace 2
    Mod+Ctrl+3                          move-column-to-workspace 3
    Mod+Ctrl+4                          move-column-to-workspace 4
    Mod+Ctrl+5                          move-column-to-workspace 5
    Mod+Ctrl+6                          move-column-to-workspace 6
    Mod+Ctrl+7                          move-column-to-workspace 7
    Mod+Ctrl+8                          move-column-to-workspace 8
    Mod+Ctrl+9                          move-column-to-workspace 9

    Mod+Tab                             focus-workspace-previous

    // ══════════════ Media / Volume ══════════════
    XF86AudioRaiseVolume                allow-when-locked=true { spawn "osd.sh" "volume" "up"; }
    XF86AudioLowerVolume                allow-when-locked=true { spawn "osd.sh" "volume" "down"; }
    XF86AudioMute                       allow-when-locked=true { spawn "osd.sh" "volume" "mute"; }
    XF86AudioPlay                       allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext                       allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev                       allow-when-locked=true { spawn "playerctl" "previous"; }

    // ══════════════ Brightness ══════════════
    XF86MonBrightnessUp                 allow-when-locked=true { spawn "osd.sh" "bright" "up"; }
    XF86MonBrightnessDown               allow-when-locked=true { spawn "osd.sh" "bright" "down"; }

    // ══════════════ Misc ══════════════
    Mod+O                               repeat=false toggle-overview
    Mod+Shift+Return                    { spawn "wpg-clock"; }

    Mod+Escape                          allow-inhibiting=false toggle-keyboard-shortcuts-inhibit

    Ctrl+Alt+Shift+Q                     { quit; }
}
