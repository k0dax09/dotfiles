# mako — generated from colorscheme.py (wallpaper palette)
font=JetBrains Mono Nerd Font 11
background-color=@{bg_t}
text-color=@{fg}
border-color=@{accent}
border-size=2
border-radius=14
padding=14
margin=10
width=380
anchor=top-right
default-timeout=5000
max-visible=5
icons=1
max-icon-size=48
icon-border-radius=10
group-by-app=yes
grouping=yes
layer=overlay

[urgency=low]
background-color=@{bg_t}
border-color=@{accent}
default-timeout=2000

[urgency=normal]
background-color=@{bg_t}
border-color=@{accent}

[urgency=critical]
background-color=@{bg_alt}
border-color=@{red}
default-timeout=0
