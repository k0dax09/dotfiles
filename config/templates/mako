# mako — generated from colorscheme.py (wallpaper palette)
# Tokens: @{bg_t} @{surface} @{fg} @{muted} @{accent} @{red} @{green} @{yellow}
font=JetBrains Mono Nerd Font 12
background-color=@{bg_t}
text-color=@{fg}
border-color=@{accent}
border-size=2
border-radius=10
padding=10
margin=8
width=360
height=120
anchor=top-right
default-timeout=5000
max-visible=6
icons=1
max-icon-size=32

[urgency=low]
background-color=@{bg_t}
border-color=@{accent}
default-timeout=2000

[urgency=normal]
background-color=@{bg_t}
border-color=@{accent}

[urgency=critical]
background-color=@{surface}
border-color=@{red}
default-timeout=0
